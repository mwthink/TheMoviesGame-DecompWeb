# Copy to local.env (gitignored) and fill in this machine's paths. Environment variables of the same name win over the file.
# Read by the web dev server and tests (web/localPaths.ts) and by the Python tools (tools/local_paths.py).

# The game install: the folder that holds MoviesSE.exe and Data/pak. Required for anything that reads game files.
# Under CrossOver it is inside the bottle, for example ~/Library/Application Support/CrossOver/Bottles/<bottle>/drive_c/Games/TheMovies
OTM_GAME_DIR=

# Optional. The archives, when they are not in <OTM_GAME_DIR>/Data/pak.
# OTM_PAK_DIR=

# Optional. Saved games and StarMaker stars; the defaults are the folders the game itself uses.
# OTM_SAVE_DIR=~/Documents/The Movies/Saved Games
# OTM_STAR_DIR=~/Documents/The Movies/StarMaker

# Optional. The save the dev server's ?autoload opens (default: the first one in OTM_SAVE_DIR).
# OTM_SAVE=

# Optional. Pin the saves the tests use for each role instead of searching OTM_SAVE_DIR (web/localPaths.ts, SAVE_ROLES).
# OTM_SAVE_FRESH=
# OTM_SAVE_QUICKSTART=

# Optional. Extracted game files for the tools and tests (default: data/game_data).
# OTM_GAME_DATA=
